<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext allowed for Tailscale/LAN peer HTTP in this slice. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
